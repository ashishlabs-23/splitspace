rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSpaceMember(spaceId) {
      return isSignedIn() && (
        request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberUids ||
        get(/databases/$(database)/documents/spaces/$(spaceId)).data.createdBy == request.auth.uid
      );
    }

    function isSpaceOwner(spaceId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/spaces/$(spaceId)).data.createdBy == request.auth.uid
      );
    }

    // 1. User Profiles: Only the account owner can modify their profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // 2. Spaces: Members can read/update; joining users can add themselves; owner can delete
    match /spaces/{spaceId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids || resource.data.createdBy == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids ||
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in request.resource.data.memberUids
      );
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // Expenses: Only verified space members can read/create/edit expenses
      match /expenses/{expenseId} {
        allow read, write: if isSpaceMember(spaceId);
      }

      // Settlements: Only verified space members can read/record payments
      match /settlements/{settlementId} {
        allow read, write: if isSpaceMember(spaceId);
      }
    }

    // 3. Invites: Public read (for invite preview) and signed-in write
    match /invites/{token} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
